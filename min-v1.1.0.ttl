@prefix min:     <https://w3id.org/min#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

# =============================================================================
#   MIN — Material · Information · Nexus   v1.1.0
#   Keine Metaphysik. Werkzeug.
#
#                        Entity
#                       ╱  │  ╲
#                  Nexus  Agent  Forma
#                 ╱│╲  ╲       ╱│╲ ╲ ╲ ╲
#          Object │ Data    Lex │ Norma │
#           Process │    Structura │    │
#              Boundary  Possibile │    │
#                        Institutio    │
#                          Epistemicum
# =============================================================================

<https://w3id.org/min> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/min/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    dcterms:title "MIN — Material · Information · Nexus"@en ,
                  "MIN — Material · Information · Nexus"@de ;
    dcterms:description "Foundational ontology for engineers. No metaphysics. A tool."@en ,
                        "Grundontologie fuer Ingenieure. Keine Metaphysik. Werkzeug."@de ;
    dcterms:creator <https://orcid.org/0000-0001-8199-8666> ;
    dcterms:created "2026-03-08"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> .

<https://orcid.org/0000-0001-8199-8666> a foaf:Person ;
    foaf:name "Dr. Ingolf Lepenies" ;
    foaf:homepage <https://github.com/lepy> .


# --- Entity (Wurzel) ---

min:Entity a owl:Class ;
    rdfs:label "Entity"@en , "Entität"@de ;
    rdfs:comment "Absolute root. Entity ≡ Nexus ⊔ Forma; Agent as orthogonal cross-category."@en ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( min:Nexus min:Forma ) ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty min:hasIdentifier ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] .


# --- Nexus (Zweig des Aktualen) ---

min:Nexus a owl:Class ;
    rdfs:subClassOf min:Entity ;
    rdfs:label "Nexus"@en , "Nexus"@de ;
    rdfs:comment "The causally efficacious. Four categories: Object, Process, Data, Boundary."@en ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( min:Object min:Process min:Data min:Boundary ) ] .

min:Object a owl:Class ;
    rdfs:subClassOf min:Nexus ;
    rdfs:label "Object"@en , "Objekt"@de ;
    rdfs:comment "Material-dominant nexus with dispositional causality."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasCausalityMode ; owl:hasValue min:CM_Dispositional ] ,
                    [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Dispositional ] .

min:Process a owl:Class ;
    rdfs:subClassOf min:Nexus ;
    rdfs:label "Process"@en , "Prozess"@de ;
    rdfs:comment "Transformation that consumes Nexus as input and produces Nexus as output."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty min:hasInput ;
        owl:someValuesFrom min:Nexus
    ] , [
        a owl:Restriction ;
        owl:onProperty min:hasOutput ;
        owl:someValuesFrom min:Nexus
    ] , [
        a owl:Restriction ; owl:onProperty min:hasCausalityMode ; owl:hasValue min:CM_Dispositional
    ] , [
        a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Dispositional
    ] .

min:Data a owl:Class ;
    rdfs:subClassOf min:Nexus ;
    rdfs:label "Data"@en , "Daten"@de ;
    rdfs:comment "Information-dominant nexus — hinge between Nexus and Forma via encodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasCausalityMode ; owl:hasValue min:CM_Mediated ] ,
                    [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Informational ] .

min:Boundary a owl:Class ;
    rdfs:subClassOf min:Nexus ;
    rdfs:label "Boundary"@en , "Grenze"@de ;
    rdfs:comment "Irreducibly relational nexus, exists only between partners."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty min:bounds ;
        owl:minCardinality "2"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty min:hasCausalityMode ; owl:hasValue min:CM_Relational
    ] , [
        a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Relational
    ] .

[] a owl:AllDisjointClasses ;
    owl:members ( min:Object min:Process min:Data min:Boundary ) .


# --- Agent (Querkategorie unter Entity) ---

min:Agent a owl:Class ;
    rdfs:subClassOf min:Entity ;
    rdfs:label "Agent"@en , "Agent"@de ;
    rdfs:comment "Orthogonal action category. Co-typing required: Agent ⊑ Nexus ⊔ Forma."@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty min:performs ;
        owl:someValuesFrom min:Process
    ] , [
        a owl:Restriction ; owl:onProperty min:hasCausalityMode ; owl:hasValue min:CM_Dispositional
    ] , [
        a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Agentive
    ] ;
    rdfs:subClassOf [ a owl:Class ; owl:unionOf ( min:Nexus min:Forma ) ] .

[] a owl:AllDisjointClasses ;
    owl:members ( min:Agent min:Process ) .


# --- Forma (Zweig des Formalen) ---

min:Forma a owl:Class ;
    rdfs:subClassOf min:Entity ;
    rdfs:label "Forma"@en , "Forma"@de ;
    rdfs:comment "The formal determinants. Forma causes nothing but determines how Nexus acts."@en ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( min:Lex min:Structura min:Possibile min:Norma min:Institutio min:Epistemicum ) ] .

min:Lex a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Lex"@en , "Lex"@de ;
    rdfs:comment "Universal regularities and natural laws. Cannot be violated."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Lawful ] .

min:Structura a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Structura"@en , "Structura"@de ;
    rdfs:comment "Mathematical and formal structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Structural ] .

min:Possibile a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Possibile"@en , "Possibile"@de ;
    rdfs:comment "Possibilities and counterfactual scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Modal ] .

min:Norma a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Norma"@en , "Norma"@de ;
    rdfs:comment "Atomic requirement, threshold or evaluation criterion."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Normative ] .

min:Institutio a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Institutio"@en , "Institution"@de ;
    rdfs:comment "Social constructs and conventional bundles. Bundles via comprises, typifies via typifies."@en ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty min:hasEfficacyMode ; owl:hasValue min:EM_Institutional ] .

min:Epistemicum a owl:Class ;
    rdfs:subClassOf min:Forma ;
    rdfs:label "Epistemicum"@en , "Epistemicum"@de ;
    rdfs:comment "That which is held to be true. Epistemic stance of an agent towards a state of affairs."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( min:Lex min:Structura min:Possibile min:Norma min:Institutio min:Epistemicum ) .

[] a owl:AllDisjointClasses ;
    owl:members ( min:Nexus min:Forma ) .


# --- Epistemische Enums ---

min:EpistemicStatus a owl:Class ;
    rdfs:label "Epistemic Status"@en , "Epistemischer Status"@de ;
    rdfs:comment "Controlled vocabulary for the epistemic standing of an Epistemicum."@en ;
    owl:oneOf ( min:ES_Hypothetical min:ES_Confirmed min:ES_Refuted
                min:ES_Contested min:ES_Axiomatic ) .

min:ES_Hypothetical  a min:EpistemicStatus ; rdfs:label "hypothetical"@en , "hypothetisch"@de .
min:ES_Confirmed     a min:EpistemicStatus ; rdfs:label "confirmed"@en , "bestaetigt"@de .
min:ES_Refuted       a min:EpistemicStatus ; rdfs:label "refuted"@en , "widerlegt"@de .
min:ES_Contested     a min:EpistemicStatus ; rdfs:label "contested"@en , "umstritten"@de .
min:ES_Axiomatic     a min:EpistemicStatus ; rdfs:label "axiomatic"@en , "axiomatisch"@de .

min:ConfidenceType a owl:Class ;
    rdfs:label "Confidence Type"@en , "Konfidenztyp"@de ;
    rdfs:comment "Controlled vocabulary for the kind of confidence behind a numeric value."@en ;
    owl:oneOf ( min:CT_Subjective min:CT_Statistical
                min:CT_Bayesian min:CT_Heuristic ) .

min:CT_Subjective    a min:ConfidenceType ; rdfs:label "subjective"@en , "subjektiv"@de .
min:CT_Statistical   a min:ConfidenceType ; rdfs:label "statistical"@en , "statistisch"@de .
min:CT_Bayesian      a min:ConfidenceType ; rdfs:label "bayesian"@en , "bayesisch"@de .
min:CT_Heuristic     a min:ConfidenceType ; rdfs:label "heuristic"@en , "heuristisch"@de .


# --- Polarität (Heuristik, nur Nexus) ---

min:materialProperty a owl:AnnotationProperty ;
    rdfs:label "material property"@en , "materiale Eigenschaft"@de ;
    rdfs:comment "Super-property for causal-spatial nexus properties. Heuristic."@en .

min:informationalProperty a owl:AnnotationProperty ;
    rdfs:label "informational property"@en , "informationale Eigenschaft"@de ;
    rdfs:comment "Super-property for structurally determined nexus properties. Heuristic."@en .


# --- Kausalitäts- und Wirksamkeitsmodus ---

min:CausalityMode a owl:Class ;
    rdfs:label "Causality Mode"@en ;
    owl:oneOf ( min:CM_Dispositional min:CM_Mediated min:CM_Relational ) .
min:CM_Dispositional a min:CausalityMode ; rdfs:label "dispositional"@en .
min:CM_Mediated      a min:CausalityMode ; rdfs:label "mediated"@en .
min:CM_Relational    a min:CausalityMode ; rdfs:label "relational"@en .

min:hasCausalityMode a owl:ObjectProperty ;
    rdfs:label "has causality mode"@en ;
    rdfs:range min:CausalityMode .

min:EfficacyMode a owl:Class ;
    rdfs:label "Efficacy Mode"@en ;
    owl:oneOf ( min:EM_Dispositional min:EM_Informational min:EM_Agentive
                min:EM_Relational min:EM_Formal min:EM_Lawful min:EM_Structural
                min:EM_Modal min:EM_Normative min:EM_Institutional ) .
min:EM_Dispositional  a min:EfficacyMode ; rdfs:label "dispositional"@en .
min:EM_Informational  a min:EfficacyMode ; rdfs:label "informational"@en .
min:EM_Agentive       a min:EfficacyMode ; rdfs:label "agentive"@en .
min:EM_Relational     a min:EfficacyMode ; rdfs:label "relational"@en .
min:EM_Formal         a min:EfficacyMode ; rdfs:label "formal"@en .
min:EM_Lawful         a min:EfficacyMode ; rdfs:label "lawful"@en .
min:EM_Structural     a min:EfficacyMode ; rdfs:label "structural"@en .
min:EM_Modal          a min:EfficacyMode ; rdfs:label "modal"@en .
min:EM_Normative      a min:EfficacyMode ; rdfs:label "normative"@en .
min:EM_Institutional  a min:EfficacyMode ; rdfs:label "institutional"@en .

min:hasEfficacyMode a owl:ObjectProperty ;
    rdfs:label "has efficacy mode"@en ;
    rdfs:range min:EfficacyMode .


# --- Inter-Nexus-Relationen ---

min:nexusWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "nexus with"@en , "verbunden mit"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Nexus .

min:hasComponent a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has component"@en , "hat Bestandteil"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:nexusWith ;
    rdfs:comment "Mereological relation. Transitive."@en .


# --- Kategorienrelationen ---

# Transformation: Process ↔ Nexus

min:hasInput a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:domain min:Process ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:nexusWith ;
    rdfs:comment "Transformative: new entity, new identity."@en .

min:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:domain min:Process ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:nexusWith ;
    rdfs:comment "Transformative: new entity, new identity."@en .

min:undergoes a owl:ObjectProperty ;
    rdfs:label "undergoes"@en ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Process ;
    owl:inverseOf min:hasInput ;
    rdfs:subPropertyOf min:nexusWith ;
    rdfs:comment "Conservative: same entity, same identity."@en .

min:resultOf a owl:ObjectProperty ;
    rdfs:label "result of"@en ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Process ;
    owl:inverseOf min:hasOutput ;
    rdfs:subPropertyOf min:nexusWith .

# Agency: Agent ↔ Process

min:performs a owl:ObjectProperty ;
    rdfs:label "performs"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Process ;
    rdfs:subPropertyOf min:nexusWith .

min:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by"@en ;
    rdfs:domain min:Process ;
    rdfs:range min:Agent ;
    owl:inverseOf min:performs ;
    rdfs:subPropertyOf min:nexusWith .

min:controls a owl:ObjectProperty ;
    rdfs:label "controls"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Process ;
    rdfs:subPropertyOf min:performs ;
    rdfs:comment "Stronger than performs: agent determines parameters."@en .

# Agent ↔ Object

min:actsOn a owl:ObjectProperty ;
    rdfs:label "acts on"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Object ;
    rdfs:subPropertyOf min:nexusWith ;
    owl:propertyChainAxiom ( min:performs min:hasInput ) .

min:affectedBy a owl:ObjectProperty ;
    rdfs:label "affected by"@en ;
    rdfs:domain min:Object ;
    rdfs:range min:Agent ;
    owl:inverseOf min:actsOn ;
    rdfs:subPropertyOf min:nexusWith .

min:owns a owl:ObjectProperty ;
    rdfs:label "owns"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Entity .

# Data-Relationen

min:describes a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:domain min:Data ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:nexusWith .

min:describedBy a owl:ObjectProperty ;
    rdfs:label "described by"@en ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Data ;
    owl:inverseOf min:describes ;
    rdfs:subPropertyOf min:nexusWith .

min:generates a owl:ObjectProperty ;
    rdfs:label "generates"@en ;
    rdfs:domain min:Process ;
    rdfs:range min:Data ;
    rdfs:subPropertyOf min:nexusWith .

min:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by"@en ;
    rdfs:domain min:Data ;
    rdfs:range min:Process ;
    owl:inverseOf min:generates ;
    rdfs:subPropertyOf min:nexusWith .

# Boundary-Relationen

min:bounds a owl:ObjectProperty ;
    rdfs:label "bounds"@en ;
    rdfs:domain min:Boundary ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:nexusWith .

min:hasBoundary a owl:ObjectProperty ;
    rdfs:label "has boundary"@en ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Boundary ;
    owl:inverseOf min:bounds ;
    rdfs:subPropertyOf min:nexusWith .

# Abgeleitete Relationen

min:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Object ;
    rdfs:subPropertyOf min:nexusWith ;
    owl:propertyChainAxiom ( min:performs min:hasOutput ) .


# --- Brückenrelationen (Nexus ↔ Forma) ---

# Generische Brücken

min:originates a owl:ObjectProperty ;
    rdfs:label "originates"@en , "bringt hervor"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Forma ;
    rdfs:comment "Nexus brings forth NEW formal determinants."@en .

min:originatedBy a owl:ObjectProperty ;
    rdfs:label "originated by"@en , "hervorgebracht durch"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Nexus ;
    owl:inverseOf min:originates .

min:realizes a owl:ObjectProperty ;
    rdfs:label "realizes"@en , "realisiert"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Forma ;
    rdfs:comment "Nexus makes EXISTING formal determinants actual."@en .

min:realizedBy a owl:ObjectProperty ;
    rdfs:label "realized by"@en ;
    rdfs:domain min:Forma ;
    rdfs:range min:Nexus ;
    owl:inverseOf min:realizes .

min:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en , "beschränkt"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Nexus ;
    rdfs:comment "Most general determination relation Forma → Nexus."@en .

min:constrainedBy a owl:ObjectProperty ;
    rdfs:label "constrained by"@en , "beschränkt durch"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Forma ;
    owl:inverseOf min:constrains .

# Spezialisierte Brücken

min:governs a owl:ObjectProperty ;
    rdfs:label "governs"@en ;
    rdfs:domain min:Lex ;
    rdfs:range min:Process ;
    rdfs:subPropertyOf min:constrains .

min:formalizes a owl:ObjectProperty ;
    rdfs:label "formalizes"@en ;
    rdfs:domain min:Structura ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:constrains .

min:evaluates a owl:ObjectProperty ;
    rdfs:label "evaluates"@en ;
    rdfs:domain min:Norma ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:constrains .

min:concerns a owl:ObjectProperty ;
    rdfs:label "concerns"@en ;
    rdfs:domain min:Possibile ;
    rdfs:range min:Nexus .

min:alternativeTo a owl:ObjectProperty ;
    rdfs:label "alternative to"@en ;
    rdfs:domain min:Possibile ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:concerns .

# Agent → Institutio

min:constitutes a owl:ObjectProperty ;
    rdfs:label "constitutes"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Institutio ;
    rdfs:subPropertyOf min:originates .

min:recognizes a owl:ObjectProperty ;
    rdfs:label "recognizes"@en ;
    rdfs:domain min:Agent ;
    rdfs:range min:Institutio .

min:constitutedBy a owl:ObjectProperty ;
    rdfs:label "constituted by"@en ;
    rdfs:domain min:Institutio ;
    rdfs:range min:Agent ;
    owl:inverseOf min:constitutes .

min:recognizedBy a owl:ObjectProperty ;
    rdfs:label "recognized by"@en ;
    rdfs:domain min:Institutio ;
    rdfs:range min:Agent ;
    owl:inverseOf min:recognizes .

# Data → Forma

min:encodes a owl:ObjectProperty ;
    rdfs:label "encodes"@en ;
    rdfs:domain min:Data ;
    rdfs:range min:Forma ;
    rdfs:comment "Data encodes Forma."@en .

min:encodedBy a owl:ObjectProperty ;
    rdfs:label "encoded by"@en ;
    rdfs:domain min:Forma ;
    rdfs:range min:Data ;
    owl:inverseOf min:encodes .

# Institutio → Nexus

min:typifies a owl:ObjectProperty ;
    rdfs:label "typifies"@en , "typifiziert"@de ;
    rdfs:domain min:Institutio ;
    rdfs:range min:Nexus ;
    rdfs:subPropertyOf min:constrains ;
    rdfs:comment "Institutio determines what kind a Nexus counts as."@en .

min:typifiedBy a owl:ObjectProperty ;
    rdfs:label "typified by"@en ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Institutio ;
    owl:inverseOf min:typifies .

# Institutio → Forma

min:comprises a owl:ObjectProperty ;
    rdfs:label "comprises"@en , "umfasst"@de ;
    rdfs:domain min:Institutio ;
    rdfs:range min:Forma ;
    rdfs:comment "Institutio bundles atomic Forma instances."@en .

min:comprisedBy a owl:ObjectProperty ;
    rdfs:label "comprised by"@en , "umfasst durch"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Institutio ;
    owl:inverseOf min:comprises .


# --- Epistemische Relationen ---

min:confirms a owl:ObjectProperty ;
    rdfs:label "confirms"@en , "bestätigt"@de ;
    rdfs:domain min:Process ;
    rdfs:range min:Forma ;
    rdfs:comment "Epistemic corroboration — not verification."@en .

min:confirmedBy a owl:ObjectProperty ;
    rdfs:label "confirmed by"@en , "bestätigt durch"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Process ;
    owl:inverseOf min:confirms .

min:refutes a owl:ObjectProperty ;
    rdfs:label "refutes"@en , "widerlegt"@de ;
    rdfs:domain min:Process ;
    rdfs:range min:Possibile ;
    rdfs:comment "Epistemic refutation of a Possibile."@en .

min:refutedBy a owl:ObjectProperty ;
    rdfs:label "refuted by"@en , "widerlegt durch"@de ;
    rdfs:domain min:Possibile ;
    rdfs:range min:Process ;
    owl:inverseOf min:refutes .

min:entails a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "entails"@en , "impliziert"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Forma ;
    rdfs:comment "Logical implication. Transitive."@en .

min:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes"@en , "löst ab"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Forma ;
    rdfs:comment "Succession. Not transitive."@en .

min:supersededBy a owl:ObjectProperty ;
    rdfs:label "superseded by"@en , "abgelöst durch"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Forma ;
    owl:inverseOf min:supersedes .

min:justifiedBy a owl:ObjectProperty ;
    rdfs:label "justified by"@en , "begründet durch"@de ;
    rdfs:domain min:Institutio ;
    rdfs:range min:Forma ;
    rdfs:comment "Epistemic grounding of an Institutio."@en .

min:justifies a owl:ObjectProperty ;
    rdfs:label "justifies"@en , "begründet"@de ;
    rdfs:domain min:Forma ;
    rdfs:range min:Institutio ;
    owl:inverseOf min:justifiedBy .


# --- Epistemicum-Relationen (v1.1.0) ---

# Agent ↔ Epistemicum

min:holds a owl:ObjectProperty ;
    rdfs:label "holds"@en , "vertritt"@de ;
    rdfs:domain min:Agent ;
    rdfs:range min:Epistemicum ;
    rdfs:comment "Agent holds an epistemic stance."@en .

min:heldBy a owl:ObjectProperty ;
    rdfs:label "held by"@en , "vertreten durch"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:Agent ;
    owl:inverseOf min:holds .

# Epistemicum → Entity

min:about a owl:ObjectProperty ;
    rdfs:label "about"@en , "ueber"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:Entity ;
    rdfs:comment "The entity this epistemic stance is about."@en .

# Epistemicum ↔ Nexus (evidence)

min:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by"@en , "gestuetzt durch"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:Nexus ;
    rdfs:comment "Nexus-level evidence that supports this epistemic stance."@en .

min:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en , "stuetzt"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Epistemicum ;
    owl:inverseOf min:supportedBy .

min:underminedBy a owl:ObjectProperty ;
    rdfs:label "undermined by"@en , "geschwaecht durch"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:Nexus ;
    rdfs:comment "Nexus-level evidence that undermines this epistemic stance."@en .

min:undermines a owl:ObjectProperty ;
    rdfs:label "undermines"@en , "schwaecht"@de ;
    rdfs:domain min:Nexus ;
    rdfs:range min:Epistemicum ;
    owl:inverseOf min:underminedBy .

# Epistemicum → Enums (functional)

min:hasEpistemicStatus a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has epistemic status"@en , "hat epistemischen Status"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:EpistemicStatus ;
    rdfs:comment "Exactly one epistemic status per Epistemicum."@en .

min:hasConfidenceType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has confidence type"@en , "hat Konfidenztyp"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range min:ConfidenceType ;
    rdfs:comment "Kind of confidence behind the numeric value. Required when hasConfidence is present."@en .


# --- Datatype Properties ---

min:hasIdentifier a owl:DatatypeProperty ;
    rdfs:label "has identifier"@en ;
    rdfs:comment "Multiple identifiers allowed (GTIN, UUID, internal ID). Not functional."@en ;
    rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain min:Entity ;
    rdfs:range xsd:string .

min:hasName a owl:DatatypeProperty ;
    rdfs:label "has name"@en ;
    rdfs:subPropertyOf rdfs:label ;
    rdfs:domain min:Entity ;
    rdfs:range xsd:string .

min:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "has timestamp"@en ;
    rdfs:subPropertyOf dcterms:date ;
    rdfs:domain min:Entity ;
    rdfs:range xsd:dateTime .

min:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    rdfs:subPropertyOf dcterms:description ;
    rdfs:domain min:Entity ;
    rdfs:range xsd:string .

min:hasStatus a owl:DatatypeProperty ;
    rdfs:label "has status"@en ;
    rdfs:domain min:Entity ;
    rdfs:range xsd:string .

min:startedAt a owl:DatatypeProperty ;
    rdfs:label "started at"@en ;
    rdfs:domain min:Process ;
    rdfs:range xsd:dateTime .

min:endedAt a owl:DatatypeProperty ;
    rdfs:label "ended at"@en ;
    rdfs:domain min:Process ;
    rdfs:range xsd:dateTime .

min:hasConfidence a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has confidence"@en , "hat Konfidenz"@de ;
    rdfs:domain min:Epistemicum ;
    rdfs:range xsd:double ;
    rdfs:comment "Quantitative confidence in [0.0, 1.0]. Requires hasConfidenceType."@en .

min:isQuantifiable a owl:DatatypeProperty ;
    rdfs:label "is quantifiable"@en , "ist quantifizierbar"@de ;
    rdfs:domain min:Possibile ;
    rdfs:range xsd:boolean ;
    rdfs:comment "true = risk (probability assignable), false = Knightian uncertainty."@en .


# --- Annotation Properties ---

min:designRationale a owl:AnnotationProperty ;
    rdfs:label "design rationale"@en ;
    min:status "deprecated" ;
    min:replacedBy min:rationale .

min:philosophicalBasis a owl:AnnotationProperty ;
    rdfs:label "philosophical basis"@en .


min:definition a owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:range xsd:string .

min:criterion a owl:AnnotationProperty ;
    rdfs:label "criterion"@en ;
    rdfs:range xsd:string .

min:usageExample a owl:AnnotationProperty ;
    rdfs:label "usage example"@en ;
    rdfs:range xsd:string .

min:counterExample a owl:AnnotationProperty ;
    rdfs:label "counterexample"@en ;
    rdfs:range xsd:string .

min:distinguishedFrom a owl:AnnotationProperty ;
    rdfs:label "distinguished from"@en ;
    rdfs:range xsd:string .

min:normativeSource a owl:AnnotationProperty ;
    rdfs:label "normative source"@en ;
    rdfs:range xsd:string .

min:rationale a owl:AnnotationProperty ;
    rdfs:label "rationale"@en ;
    rdfs:range xsd:string .

min:definedInVersion a owl:AnnotationProperty ;
    rdfs:label "defined in version"@en ;
    rdfs:range xsd:string .

min:status a owl:AnnotationProperty ;
    rdfs:label "status"@en ;
    rdfs:range xsd:string ;
    rdfs:comment "experimental | stable | deprecated."@en .

min:replacedBy a owl:AnnotationProperty ;
    rdfs:label "replaced by"@en ;
    rdfs:range rdfs:Resource .

min:axiomRationale a owl:AnnotationProperty ;
    rdfs:label "axiom rationale"@en ;
    rdfs:range xsd:string .
